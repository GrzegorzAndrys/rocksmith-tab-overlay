<Window x:Class="RocksmithTabOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RocksmithTabOverlay"
        Title="Rocksmith TAB Overlay"
        Width="1200" Height="390"
        MinWidth="500" MinHeight="250"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        MouseLeftButtonDown="OnWindowMouseLeftButtonDown">
    <Grid Background="#01000000">
        <local:TabSurface x:Name="Tab" Margin="12" IsHitTestVisible="False" />

        <Border x:Name="EditFrame"
                Margin="4" BorderThickness="2" CornerRadius="12"
                BorderBrush="#FF48D6FF" Background="Transparent"
                IsHitTestVisible="False" Visibility="Collapsed" />

        <Border x:Name="EditHint"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0"
                Padding="14,6" CornerRadius="7"
                Background="#EF121820" BorderBrush="#FF48D6FF" BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel Width="460">
                <TextBlock Text="DRAG TO MOVE   •   DRAG CORNER TO RESIZE   •   F TO LOCK"
                           Foreground="White" FontFamily="Consolas" FontSize="12"
                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="24" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="DARK BACKGROUND"
                               Foreground="#FFB9C4D0" FontFamily="Consolas" FontSize="11"
                               VerticalAlignment="Center" />
                    <Slider x:Name="BackgroundOpacitySlider" Grid.Row="0" Grid.Column="1"
                            Minimum="0" Maximum="1" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" Margin="8,0"
                            ValueChanged="OnBackgroundOpacityChanged" />
                    <TextBlock x:Name="BackgroundOpacityValue" Grid.Row="0" Grid.Column="2"
                               Foreground="White" FontFamily="Consolas" FontSize="11"
                               TextAlignment="Right" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="EVERYTHING"
                               Foreground="#FFB9C4D0" FontFamily="Consolas" FontSize="11"
                               VerticalAlignment="Center" />
                    <Slider x:Name="OverlayOpacitySlider" Grid.Row="1" Grid.Column="1"
                            Minimum="0.15" Maximum="1" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" Margin="8,0"
                            ValueChanged="OnOverlayOpacityChanged" />
                    <TextBlock x:Name="OverlayOpacityValue" Grid.Row="1" Grid.Column="2"
                               Foreground="White" FontFamily="Consolas" FontSize="11"
                               TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Button Content="RESTART OVERLAY"
                        HorizontalAlignment="Right" Margin="0,7,0,0" Padding="12,4"
                        Background="#FF1F2C36" Foreground="White"
                        BorderBrush="#FF48D6FF" BorderThickness="1"
                        FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                        Cursor="Hand" Click="OnRestartOverlayClick"
                        ToolTip="Save the layout and restart the TAB overlay" />
            </StackPanel>
        </Border>

        <Border x:Name="ResizeGrip"
                Width="34" Height="34" Margin="0,0,7,7"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="#EF121820" BorderBrush="#FF48D6FF" BorderThickness="1"
                CornerRadius="6" Cursor="SizeNWSE"
                MouseLeftButtonDown="OnResizeGripMouseLeftButtonDown"
                Visibility="Collapsed">
            <TextBlock Text="◢" Foreground="#FF48D6FF" FontSize="20"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
